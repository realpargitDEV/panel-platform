# Rendered by the agent from manifest-validated values. Every substitution is
# an allow-listed choice or a validated identifier — never free text.
#
# Multi-stage so build tooling and dev dependencies never reach the runtime
# image: a smaller image is a smaller attack surface, and TypeScript projects
# would otherwise ship their compiler.

FROM {{base_image}} AS deps
WORKDIR /app

{{#if uses_pnpm}}
RUN corepack enable && corepack prepare pnpm@latest --activate
{{/if}}

# Manifests first so a dependency install is cached independently of source.
COPY --chown=10001:10001 {{manifest_files}} ./
RUN {{install_command}}

{{#if build_command}}
FROM deps AS build
WORKDIR /app
COPY --chown=10001:10001 . .
RUN {{build_command}}
{{/if}}

FROM {{base_image}} AS runtime

# A fixed non-root uid, identical across every template. Files written by the
# container are then predictable on the host.
RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app
ENV NODE_ENV=production

{{#if build_command}}
COPY --from=build --chown=10001:10001 /app ./
{{else}}
COPY --from=deps --chown=10001:10001 /app/node_modules ./node_modules
COPY --chown=10001:10001 . .
{{/if}}

USER 10001:10001

{{#if health_check_command}}
HEALTHCHECK --interval={{health_interval}}s --timeout={{health_timeout}}s \
            --retries={{health_retries}} --start-period={{health_start_period}}s \
            CMD {{health_check_command}}
{{/if}}

# Exec form, so the process is PID 1 and receives SIGTERM directly. The shell
# form would swallow it and leave stops to the kill timeout.
CMD {{start_command_json}}
