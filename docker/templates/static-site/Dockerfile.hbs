# Rendered by the agent from manifest-validated values.

{{#if build_command}}
FROM {{build_base_image}} AS build
WORKDIR /app
COPY --chown=10001:10001 {{manifest_files}} ./
RUN {{install_command}}
COPY --chown=10001:10001 . .
RUN {{build_command}}
{{/if}}

FROM {{base_image}} AS runtime

# nginx-unprivileged already runs as 101; the config below moves it to the
# uid every Project Host container uses, so host file ownership is uniform.
USER root
RUN sed -i 's/^user .*/# user directive removed: the container runs non-root/' \
      /etc/nginx/nginx.conf || true
COPY nginx.conf /etc/nginx/conf.d/default.conf

{{#if build_command}}
COPY --from=build --chown=10001:10001 /app/{{publish_dir}} /usr/share/nginx/html
{{else}}
COPY --chown=10001:10001 {{publish_dir}} /usr/share/nginx/html
{{/if}}

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval={{health_interval}}s --timeout={{health_timeout}}s \
            --retries={{health_retries}} --start-period={{health_start_period}}s \
            CMD ["/usr/bin/curl", "-fsS", "http://127.0.0.1:8080/"]

CMD ["nginx", "-g", "daemon off;"]
