# Rendered by the agent from manifest-validated values.

FROM {{base_image}} AS runtime

RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

# Unbuffered so logs appear as they are written rather than when a buffer
# happens to flush — a bot that logged nothing for a minute would look hung.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

{{#if uses_poetry}}
RUN pip install --no-cache-dir poetry && poetry config virtualenvs.create false
{{/if}}
{{#if uses_uv}}
RUN pip install --no-cache-dir uv
{{/if}}
{{#if uses_pipenv}}
RUN pip install --no-cache-dir pipenv
{{/if}}

# Dependency manifests first, so installing is cached apart from the source.
COPY --chown=10001:10001 {{manifest_files}} ./
RUN {{install_command}}

COPY --chown=10001:10001 . .

USER 10001:10001

{{#if health_check_command}}
HEALTHCHECK --interval={{health_interval}}s --timeout={{health_timeout}}s \
            --retries={{health_retries}} --start-period={{health_start_period}}s \
            CMD {{health_check_command}}
{{/if}}

CMD {{start_command_json}}
